                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const deadline = Date.now() + 15000;",
                  "const url = pm.variables.get('baseUrl') + '/api/v1/notifications?limit=50';",
                  "const auth = { authorization: 'Bearer ' + pm.collectionVariables.get('ownerToken') };",
                  "const companyId = pm.collectionVariables.get('companyId');",
                  "(function poll() {",
                  "  pm.sendRequest({ url, header: auth }, (err, res) => {",
                  "    if (!err && res.code === 200 && res.json().items.some((i) => i.company_id === companyId)) return;",
                  "    if (Date.now() > deadline) return console.warn('no notification for the company within 15s');",
                  "    setTimeout(poll, 500);",
                  "  });",
                  "})();",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "",
                  "const items = pm.response.json().items;",
                  "pm.test('COMPANY_APPROVED notification for this company', () => {",
                  "  const n = items.find((i) => i.company_id === pm.collectionVariables.get('companyId'));",
                  "  pm.expect(n, 'notification').to.exist;",
                  "  pm.expect(n.message_code).to.eql('COMPANY_APPROVED');",
                  "});",
                  ""
                ]
              }
            }
          ]
        }
