{
  "info": {
    "name": "DV Platform",
    "description": "Public API of the DV platform (core, verification, notification) behind Nginx, with Keycloak tokens.\n\nTokens for owner, reviewer and employee are fetched automatically by the collection pre-request script\nand refreshed before they expire. Select the \"DV Platform — local\" environment, then run folder 1.\n\nInternal endpoints (/internal/v1/*, /health, /ready) are only reachable on the 127.0.0.2 internal\nlistener inside WSL and are not included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Fetches a password-grant token for each demo user and caches it until 15s before expiry.",
          "const users = [",
          "  { key: 'owner',    username: pm.variables.get('ownerUsername'),    password: pm.variables.get('ownerPassword') },",
          "  { key: 'reviewer', username: pm.variables.get('reviewerUsername'), password: pm.variables.get('reviewerPassword') },",
          "  { key: 'employee', username: pm.variables.get('employeeUsername'), password: pm.variables.get('employeePassword') },",
          "];",
          "const tokenUrl = pm.variables.get('keycloakUrl') + '/realms/' + pm.variables.get('realm') + '/protocol/openid-connect/token';",
          "const now = Date.now();",
          "",
          "users.forEach((u) => {",
          "  const exp = Number(pm.collectionVariables.get(u.key + 'TokenExp') || 0);",
          "  if (pm.collectionVariables.get(u.key + 'Token') && exp - 15000 > now) return;",
          "  pm.sendRequest({",
          "    url: tokenUrl,",
          "    method: 'POST',",
          "    header: { 'content-type': 'application/x-www-form-urlencoded' },",
          "    body: {",
          "      mode: 'urlencoded',",
          "      urlencoded: [",
          "        { key: 'grant_type', value: 'password' },",
          "        { key: 'client_id', value: pm.variables.get('clientId') },",
          "        { key: 'username', value: u.username },",
          "        { key: 'password', value: u.password },",
          "      ],",
          "    },",
          "  }, (err, res) => {",
          "    if (err || res.code !== 200) {",
          "      console.error('token for ' + u.key + ' failed', err || res.text());",
          "      return;",
          "    }",
          "    const body = res.json();",
          "    pm.collectionVariables.set(u.key + 'Token', body.access_token);",
          "    pm.collectionVariables.set(u.key + 'TokenExp', String(now + body.expires_in * 1000));",
          "  });",
          "});",
          ""
        ]
      }
    }
  ],
