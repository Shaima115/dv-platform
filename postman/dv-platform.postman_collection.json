          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const deadline = Date.now() + 15000;",
                  "const url = pm.variables.get('baseUrl') + '/api/v1/companies/' + pm.collectionVariables.get('companyId');",
                  "const auth = { authorization: 'Bearer ' + pm.collectionVariables.get('ownerToken') };",
                  "(function poll() {",
                  "  pm.sendRequest({ url, header: auth }, (err, res) => {",
                  "    if (!err && res.code === 200 && res.json().status === 'approved') return;",
                  "    if (Date.now() > deadline) return console.warn('company did not reach approved within 15s');",
                  "    setTimeout(poll, 500);",
                  "  });",
                  "})();",
                  ""
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "",
                  "const company = pm.response.json();",
                  "pm.test('company approved by the event', () => pm.expect(company.status).to.eql('approved'));",
                  "pm.test('decision reason carried over', () => pm.expect(company.decisionReasonCode).to.eql('documents_valid'));",
                  ""
                ]
              }
            }
          ]
        },
