              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "companies"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Happy Path Co {{$timestamp}}\",\n  \"registrationNumber\": \"REG-{{$randomInt}}\",\n  \"countryCode\": \"JO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "",
                  "",
                  "const company = pm.response.json();",
                  "pm.test('starts as draft', () => pm.expect(company.status).to.eql('draft'));",
