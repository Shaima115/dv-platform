# DV platform configuration. Copy to .env for local development; in production set these through
# the process manager or a secret store. Every service validates its variables at startup and refuses
# to start when one is missing or invalid. Values below marked CHANGE_ME must be replaced.

# ---- Runtime --------------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL 17 ---------------------------------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=dv
# Migration administrator: owns the schemas, runs migrations, never used at runtime.
MIGRATOR_DB_USER=dv_migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME
# One runtime role per service; each can reach only its own schemas.
CORE_DB_USER=dv_core
CORE_DB_PASSWORD=CHANGE_ME
VERIFICATION_DB_USER=dv_verification
VERIFICATION_DB_PASSWORD=CHANGE_ME
NOTIFICATION_DB_USER=dv_notification
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# ---- Keycloak (realm jo) ----------------------------------------------------------------------------
KEYCLOAK_ISSUER=http://127.0.0.1:8180/realms/jo
KEYCLOAK_JWKS_URI=http://127.0.0.1:8180/realms/jo/protocol/openid-connect/certs
KEYCLOAK_TOKEN_URL=http://127.0.0.1:8180/realms/jo/protocol/openid-connect/token
# Clients that may present user tokens / service tokens (strict allowlists).
KEYCLOAK_USER_CLIENT_IDS=web
KEYCLOAK_SERVICE_CLIENT_IDS=svc-core,svc-verification,svc-notification
JWT_CLOCK_TOLERANCE_S=0
JWKS_CACHE_MAX_AGE_MS=600000

# Confidential client credentials (client credentials grant). Each service reads only its own.
CORE_CLIENT_ID=svc-core
CORE_CLIENT_SECRET=CHANGE_ME
VERIFICATION_CLIENT_ID=svc-verification
VERIFICATION_CLIENT_SECRET=CHANGE_ME
NOTIFICATION_CLIENT_ID=svc-notification
NOTIFICATION_CLIENT_SECRET=CHANGE_ME

# ---- HTTP listeners (bind to loopback; Nginx is the only way in) -------------------------------------
CORE_HOST=127.0.0.1
CORE_PORT=3001
VERIFICATION_HOST=127.0.0.1
VERIFICATION_PORT=3002
NOTIFICATION_HOST=127.0.0.1
NOTIFICATION_PORT=3003

# ---- Internal service URLs: always the Nginx internal listener, never a port ---------------------------
VERIFICATION_INTERNAL_URL=http://svc-verification.internal

# ---- core -> verification call --------------------------------------------------------------------
VERIFICATION_CALL_TIMEOUT_MS=2000
VERIFICATION_CALL_MAX_RETRIES=2
VERIFICATION_CALL_BACKOFF_BASE_MS=150
VERIFICATION_CALL_DEADLINE_MS=4500
# How long a submission claim blocks a concurrent submission for the same company.
VERIFICATION_SUBMISSION_CLAIM_MS=10000

# ---- Circuit breaker (opossum) ----------------------------------------------------------------------
BREAKER_ERROR_THRESHOLD_PCT=50
BREAKER_VOLUME_THRESHOLD=3
BREAKER_ROLLING_WINDOW_MS=30000
BREAKER_RESET_TIMEOUT_MS=15000

# ---- Outbox relays --------------------------------------------------------------------------------
CORE_SUBSCRIPTIONS_FILE=config/subscriptions/core.json
VERIFICATION_SUBSCRIPTIONS_FILE=config/subscriptions/verification.json
RELAY_POLL_INTERVAL_MS=250
RELAY_BATCH_SIZE=50
RELAY_MAX_IN_FLIGHT=20
# Share of RELAY_MAX_IN_FLIGHT one subscriber may use, so a slow subscriber cannot hold up the others.
RELAY_MAX_IN_FLIGHT_PER_SUBSCRIBER=5
RELAY_LEASE_MS=15000
RELAY_DELIVERY_TIMEOUT_MS=5000
RELAY_BACKOFF_BASE_MS=1000
RELAY_BACKOFF_MAX_MS=60000
# Total attempts including the first; the row is marked dead after this many failures.
RELAY_MAX_ATTEMPTS=5

# ---- Development-only fault injection (refused when NODE_ENV=production) ---------------------------
# Company ids listed one per line in this file make the notification handler throw (demo scenario 10).
NOTIFICATION_FAULT_FILE=

# ---- Demo script (development credentials from keycloak/realm-jo.json) ------------------------------
DEMO_PUBLIC_URL=http://127.0.0.1:8080
DEMO_INTERNAL_IP=127.0.0.2
DEMO_KEYCLOAK_URL=http://127.0.0.1:8180
DEMO_OWNER_USERNAME=owner@demo.jo
DEMO_OWNER_PASSWORD=CHANGE_ME
DEMO_REVIEWER_USERNAME=reviewer@demo.jo
DEMO_REVIEWER_PASSWORD=CHANGE_ME
DEMO_EMPLOYEE_USERNAME=employee@demo.jo
DEMO_EMPLOYEE_PASSWORD=CHANGE_ME

# ---- Integration tests only (never set in production) -----------------------------------------------
# A PostgreSQL superuser lets the test suite create and drop a throwaway database per run.
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=CHANGE_ME
